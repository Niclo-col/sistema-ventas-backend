# Copia este archivo a .env y completa los valores reales. .env nunca se versiona.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://sales_user:sales_password@localhost:5432/sales_db?schema=public"
POSTGRES_USER=sales_user
POSTGRES_PASSWORD=sales_password
POSTGRES_DB=sales_db

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Reglas de negocio
ORDER_CANCELLATION_WINDOW_MINUTES=15

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
